{
  "demand": {
    "file": "demand.csv",
    "columns": {
      "heat_kw": "heating_demand",
      "cool_kw": "cooling_demand"
    },
    "unit": "kW",
    "time_column": "timestamp"
  },
  "site": {
    "d*.gradient": {"value": 36, "unit": "K/km"},
    "d*.surface_temperature": {"value": 9, "unit": "degC"},
    "d*.thickness": {"value": 60, "unit": "m"},
    "d*.permeability": {"value": 450, "unit": "mD"},
    "d*.reservoir.pressure": {"value": 120, "unit": "barg"},
    "d*.sink.pressure": {"value": 120, "unit": "barg"}
  },
  "constraints": [
    {
      "path": "d*.reservoir.liquid_flow",
      "min": {"value": 35, "unit": "m3/h"},
      "max": {"value": 180, "unit": "m3/h"},
      "when": "running"
    },
    {
      "path": "d*.brine_cooling",
      "max": {"value": 22, "unit": "K"},
      "when": "running"
    },
    {
      "path": "d*.reservoir.liquid_flow",
      "max": {"value": 450, "unit": "h"},
      "over": "duration",
      "when": "running"
    },
    {
      "path": "d*.pump_efficiency",
      "min": 0.6,
      "max": 0.68
    },
    {
      "path": "d*.volume_imbalance",
      "min": {"value": -1e-05, "unit": "m3/s"},
      "max": {"value": 1e-05, "unit": "m3/s"},
      "when": "running"
    },
    {
      "path": "heating_consumer.supply_in.temperature",
      "min": {"value": 65, "unit": "degC"},
      "when": "running"
    },
    {
      "path": "cooling_consumer.supply_in.temperature",
      "max": {"value": 16, "unit": "degC"},
      "when": "running"
    }
  ],
  "assumptions": {
    "discount_rate": 0.04,
    "lifetime_years": 30,
    "electricity_emission_factor": {"value": 360, "unit": "g/kWh"},
    "prices": {
      "electricity": {"value": 120, "unit": "EUR/MWh"},
      "gas": {"value": 55, "unit": "EUR/MWh"}
    }
  }
}
