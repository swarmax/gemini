{
  "demand": {
    "file": "demand.csv",
    "columns": {
      "heating_demand_MWth": "heating_demand",
      "cooling_demand_MWcool": "cooling_demand"
    },
    "unit": "MW",
    "time_column": "date"
  },
  "site": {
    "d*.gradient": {"value": 30, "unit": "K/km"},
    "d*.surface_temperature": {"value": 12, "unit": "degC"},
    "d*.thickness": {"value": 100, "unit": "m"},
    "d*.permeability": {"value": 200, "unit": "mD"}
  },
  "constraints": [
    {
      "path": "d*.reservoir.liquid_flow",
      "min": {"value": 50, "unit": "m3/h"},
      "max": {"value": 300, "unit": "m3/h"},
      "when": "running"
    },
    {
      "path": "d*.brine_cooling",
      "max": {"value": 40, "unit": "K"},
      "when": "running"
    },
    {
      "path": "heat_users.supply_in.temperature",
      "min": {"value": 100, "unit": "degC"},
      "when": "running"
    }
  ],
  "assumptions": {
    "discount_rate": 0.05,
    "lifetime_years": 25,
    "electricity_emission_factor": {"value": 300, "unit": "g/kWh"},
    "pump_cost": {"value": 0.5, "unit": "EUR/W"},
    "chiller_cost": {"value": 0.3, "unit": "EUR/W"},
    "exchanger_cost": {"value": 0.5, "unit": "EUR/(W/K)"},
    "flare_cost": {"value": 100000, "unit": "EUR"},
    "makeup_cost": {"value": 50000, "unit": "EUR"},
    "prices": {
      "electricity": {"value": 100, "unit": "EUR/MWh"},
      "gas": {"value": 40, "unit": "EUR/MWh"},
      "heat": {"value": 60, "unit": "EUR/MWh"},
      "cold": {"value": 60, "unit": "EUR/MWh"},
      "waste_disposal": {"value": 0.2, "unit": "EUR/kg"},
      "chemical": {"value": 3, "unit": "EUR/kg"}
    }
  }
}
